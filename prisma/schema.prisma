// Prisma schema for Career Ops AI
// Database: Neon PostgreSQL (serverless)
// Auto-deletes records older than 30 days via cleanup API

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

model JobApplication {
  id            String   @id @default(cuid())
  // Job details
  jobTitle      String
  companyName   String
  jobUrl        String
  jobLocation   String? // e.g., "Remote", "Jakarta, Indonesia"
  jobLevel      String? // "internship" | "junior" | "intermediate" | "senior"
  jobType       String? // "full-time" | "contract" | "internship" | "freelance"
  jobSource     String? // "greenhouse" | "workable" | "manual" | "linkedin"
  // Match & evaluation
  matchScore    Int?     // 0-100
  evaluation    Json?    // AI evaluation result (full markdown)
  coverLetter   String?  // Generated cover letter
  // Application tracking
  status        String   @default("to_apply") // to_apply | applied | interview | offer | rejected
  appliedAt     DateTime?
  interviewDate DateTime?
  notes         String?
  // Metadata
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([companyName])
}

model ScanLog {
  id            String   @id @default(cuid())
  source        String   // "greenhouse" | "workable"
  query         String?
  resultsFound  Int      @default(0)
  resultsSaved  Int      @default(0)
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([source])
}
